# The Laravel backend's API base URL. Read at BUILD time by Vite
# (import.meta.env.VITE_API_BASE_URL in src/services/api.js) — changing this
# after the app is built has no effect; it must be set before `npm run build`
# runs, and a browser can't switch it at runtime.
#
# This is why the cloud and local deployments need two SEPARATE builds, not
# one build reused in two places: this file/`.env` feeds the default
# (cloud/Vercel) build, pointed at the Railway backend. The hospital's local
# machine needs its own build instead — see .env.hospital and the
# `build:hospital` script in package.json.
VITE_API_BASE_URL=http://a4backend.test/api
