########################################
# APPLICATION
########################################

# Shown in emails, page titles, etc. Set to the hospital's actual name.
APP_NAME="A4 Medical Consortium"

# local | production. Controls Laravel's own environment-aware defaults
# (error verbosity, some package behavior). Set to `production` on the live
# server.
APP_ENV=local

# Encrypts session data and other Laravel-internal values. Generate with
# `php artisan key:generate` — never reuse a key across environments, and
# never reuse the developer's own dev-machine key in production.
APP_KEY=

# When true, unhandled errors show full stack traces (including file paths
# and query values) directly in the HTTP response. Fine for local
# development; MUST be false in production — leaving it true leaks internal
# details to anyone who can trigger an error.
APP_DEBUG=true

# The backend's own public URL. Used to build absolute links (e.g. in some
# generated URLs/emails). Set to the real API domain in production.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Password hashing cost — higher is slower but more resistant to brute
# force. 12 is a solid default; only raise it if the server can absorb the
# extra CPU cost on every login/registration.
BCRYPT_ROUNDS=12

########################################
# LOGGING
########################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# debug is noisy (logs everything, including routine operations) — fine
# for local dev. Set to `error` in production so the log file only fills up
# with things that actually need attention.
LOG_LEVEL=debug

########################################
# DATABASE
########################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# The hospital's real database name/user/password in production — never
# the developer's own local dev credentials.
DB_DATABASE=hms_db
DB_USERNAME=root
DB_PASSWORD=

# Gates the "Admin" option on the public registration form — someone must
# know this value to self-register as an administrator (every other staff
# role instead registers as "pending" and waits for an existing admin to
# approve them from the Users tab). Generate a long random value per
# environment, e.g. `php -r "echo bin2hex(random_bytes(24));"` — never reuse
# the same value across dev/staging/production, and rotate it if it's ever
# shared with someone who shouldn't have lasting admin-creation rights.
ADMIN_SECRET=

########################################
# FRONTEND
########################################

# The React app's own URL — used to build links back to the frontend (e.g.
# the password-reset link emailed to a user, Google OAuth's post-login
# redirect). Must match wherever the frontend is actually hosted, including
# protocol (http/https).
FRONTEND_URL=

# Which origins the browser is allowed to call this API from (config/cors.php).
# Comma-separated, NO SPACES after the commas — a bare space in an
# unquoted .env value breaks parsing entirely (wrap the whole value in
# double quotes if you want spaces for readability). No trailing slash on
# any entry. On the CLOUD deployment this should be the real Vercel domain
# (FRONTEND_URL above, basically). On the LOCAL deployment this should be
# wherever the hospital's own local frontend build ends up served from —
# see Frontend/.env.hospital for that build's own config. Leave unset to
# fall back to this app's original defaults (production domain + common
# local dev ports), which is fine for local development but should be set
# explicitly for any real deployment.
CORS_ALLOWED_ORIGINS=

########################################
# SESSION
########################################

SESSION_DRIVER=database
# Minutes of inactivity before a web session expires. Note this is
# separate from the JWT_TTL below, which governs API token expiry — most of
# this app's own auth uses JWT, not Laravel sessions.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

########################################
# JWT (API AUTHENTICATION)
########################################

# How this app actually authenticates API requests (tymon/jwt-auth), as
# opposed to the SESSION_* settings above.

# Minutes before an access token expires and the frontend must silently
# refresh it.
JWT_TTL=60
# Minutes a refresh token stays valid before the user is forced to log in
# again from scratch (20160 = 14 days).
JWT_REFRESH_TTL=20160
# Grace period (minutes) during which a just-invalidated token is still
# accepted — absorbs requests that were already in flight when a token was
# refreshed/blacklisted, so they don't fail with a race-condition 401.
JWT_BLACKLIST_GRACE_PERIOD=30
# Signs and verifies every JWT issued by this app. Generate with
# `php artisan jwt:secret`. Treat like a password: never commit it, never
# reuse it across environments, and rotating it invalidates every
# currently-logged-in user's session.
JWT_SECRET=

########################################
# QUEUE / CACHE / BROADCASTING
########################################

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Not currently used by this app (no realtime/broadcast features rely on
# Redis), but Laravel's skeleton wires it up by default. Safe to leave as
# is unless a future feature needs it.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

########################################
# MAIL
########################################

# GO-LIVE: MAIL_MAILER=log only writes emails to the log file — nothing is
# actually delivered, so password reset / appointment / report-request
# notifications silently don't reach patients. Before go-live, create a
# Resend account (https://resend.com) under the hospital's own email,
# verify a sending domain there, then set MAIL_MAILER=resend and
# RESEND_API_KEY below. The smtp/scheme/host/port/username/password
# settings below are unused once you switch to resend — they're only
# read by the smtp mailer.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# The "From" address on every email this app sends (password reset,
# contact form replies, bug reports, account-approved notices). Should be
# the hospital's own address, not a personal one.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# API key from your Resend account/domain. Required once MAIL_MAILER=resend.
RESEND_API_KEY=

# Where automated-backup failure alerts (config/backup.php) get sent.
# Defaults to MAIL_FROM_ADDRESS if left blank — set this separately if
# backup alerts should go to a different inbox (e.g. whoever's actually on
# call) than patient-facing "From" mail.
BACKUP_ALERT_EMAIL=

########################################
# OFFLINE SYNC — CLOUD ⇄ LOCAL SERVER
########################################

# Shared secret both deployments must have identically — generate ONE value
# with `php artisan tinker --execute="echo Str::random(40);"` and set it here
# on BOTH the cloud and local .env files. Authenticates the server-to-server
# sync calls (App\Http\Middleware\VerifySyncKey), since there's no logged-in
# user on either end of that request.
SYNC_SECRET=

# Only needed on the LOCAL deployment — the base URL of the cloud backend
# (e.g. https://your-app.up.railway.app). Leave blank on the cloud
# deployment itself; the sync:* commands exit quietly when this is unset,
# since the cloud server never needs to call itself.
SYNC_CLOUD_URL=

########################################
# FILE STORAGE (S3-COMPATIBLE) — OPTIONAL
########################################

# Only needed if you point a storage disk (e.g. database backups in
# config/backup.php, or file uploads) at S3-compatible storage instead of
# the local disk. Leave blank to keep using local disk — but note that on
# a container host like Railway, local disk doesn't survive a redeploy
# unless a persistent volume is attached, so anything you need to actually
# keep (like backups) should end up here or on a mounted volume.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

########################################
# FRONTEND BUILD-TIME VARS
########################################

# Baked into the frontend bundle at build time (Vite), not read at runtime
# by the backend. Only relevant if the frontend build process reads this
# same .env file.
VITE_APP_NAME="${APP_NAME}"

########################################
# PAYSTACK — CURRENTLY DISABLED
########################################

# Online card payments are off by default — A4 Medical Consortium collects
# payment physically (cash/POS/transfer) at the desk instead. The
# integration code is still in place (not deleted), so it can be
# re-enabled later without a redeploy of new code — just flip
# PAYSTACK_ENABLED and supply real keys.
# Get real keys from https://dashboard.paystack.com/#/settings/developer
# — sk_test_/pk_test_ for testing, sk_live_/pk_live_ once actually
# accepting real payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_ENABLED=false

########################################
# GOOGLE OAUTH ("Sign in with Google")
########################################

# From a Google Cloud project's OAuth 2.0 credentials
# (console.cloud.google.com → APIs & Services → Credentials). Must be
# created under the hospital's own Google account, not a developer's
# personal one — this is a real account of record for the hospital, not a
# throwaway.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that same OAuth client
# (protocol, domain, and path all have to match). Point this at the real
# backend domain in production — a dev tunnel URL (ngrok etc.) only works
# while that specific tunnel session is running and must not ship as-is.
GOOGLE_REDIRECT_URI=
